# Neon PostgreSQL Database
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production

# Bedrock AI Configuration
AI_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=minimax.minimax-m2.5
AWS_BEARER_TOKEN_BEDROCK=

# Security & CORS
JWT_SECRET=bookleaf-secure-secret-key-for-development-32chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
